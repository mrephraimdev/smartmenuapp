# ===========================================
# HorusPOS - Variables d'environnement Docker
# Copier vers .env et remplir les valeurs
# ===========================================

APP_NAME="HorusPOS"
APP_ENV=staging
APP_KEY=                        # généré automatiquement au 1er démarrage si vide
APP_DEBUG=true
APP_URL=http://localhost         # remplacer par votre domaine: https://monapp.railway.app

APP_TIMEZONE=Africa/Abidjan
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# ===========================================
# BASE DE DONNÉES (PostgreSQL via Docker)
# ===========================================
DB_CONNECTION=pgsql
DB_HOST=postgres                # nom du service docker-compose
DB_PORT=5432
DB_DATABASE=horuspos
DB_USERNAME=horuspos
DB_PASSWORD=horuspos_secret    # changer en production

# ===========================================
# REDIS (via Docker)
# ===========================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis                # nom du service docker-compose
REDIS_PORT=6379
REDIS_PASSWORD=null

# ===========================================
# SESSION / CACHE / QUEUE
# ===========================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ===========================================
# LOGS
# ===========================================
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ===========================================
# MAIL (mode log pour les tests)
# ===========================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@horuspos.local"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# HORUSPOS
# ===========================================
DEFAULT_CURRENCY=XOF
QR_CODE_SIZE=300
QR_CODE_MARGIN=10
ORDER_NUMBER_PREFIX=CMD
ORDER_EXPIRY_HOURS=24
API_RATE_LIMIT=60
ORDER_RATE_LIMIT=10
TENANT_ISOLATION=true

# ===========================================
# PORTS EXTERNES (optionnel)
# ===========================================
APP_PORT=80
APP_PORT_SSL=443
DB_PORT_EXTERNAL=5432
REDIS_PORT_EXTERNAL=6379
